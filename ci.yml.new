name: AI 扫描

# 重要：本文件 ci.yml.new 是给 GitHub 机器人没有 workflows 写权限时用的迁移源。
# 维护方式：当 oai.yml 需要更新时，由 bot 把新内容写进本文件，
# 仓库维护者用网页编辑器把 ci.yml.new 整段复制到 .github/workflows/oai.yml 并提交。
# 本文件与 oai.yml 内容始终保持一致。

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    # 每天澳门时间 08:00 (UTC 00:00) 自动扫描并推送
    - cron: '0 0 * * *'
  workflow_dispatch:
    inputs:
      channels:
        description: '要扫描的频道，多个用 | 分隔，留空使用全部 56 个频道全量扫描'
        required: false
        default: ''
        type: string
      push_to_wechat:
        description: '扫描完成后自动推送到微信（PushPlus）'
        required: false
        default: false
        type: boolean
      pushplus_token:
        description: '临时 PushPlus token（优先于 Secrets.PUSHPLUS_TOKEN）'
        required: false
        default: ''
        type: string
      enable_ai_summary:
        description: '推送前用 AI（DeepSeek）对视频字幕做主题聚类总结'
        required: false
        default: true
        type: boolean

env:
  NODE_VERSION: 20

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node-version: [18, 20]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}

      - name: Cache node_modules
        uses: actions/cache@v4
        with:
          path: node_modules
          key: ${{ runner.os }}-node${{ matrix.node-version }}-${{ hashFiles('package-lock.json', 'package.json') }}
          restore-keys: |
            ${{ runner.os }}-node${{ matrix.node-version }}-

      - name: Install dependencies
        run: npm install

      - name: Check syntax
        run: node --check server.js && node --check app.js && node --check ai.mjs

      - name: Verify server starts
        timeout-minutes: 2
        run: |
          node server.js &
          SERVER_PID=$!
          sleep 3
          curl -sf --max-time 5 http://localhost:3000/ > /dev/null || { echo "::error::Server failed to start"; kill $SERVER_PID 2>/dev/null; exit 1; }
          kill $SERVER_PID 2>/dev/null
          echo "✅ Server started and responded on port 3000"

  # ─── 手动触发 + 微信推送 ───
  scan-and-push:
    if: ${{ github.event_name == 'workflow_dispatch' && inputs.push_to_wechat }}
    needs: build-and-test
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Cache node_modules
        uses: actions/cache@v4
        with:
          path: node_modules
          key: ${{ runner.os }}-node${{ env.NODE_VERSION }}-${{ hashFiles('package-lock.json', 'package.json') }}
          restore-keys: |
            ${{ runner.os }}-node${{ env.NODE_VERSION }}-

      - name: Install dependencies
        run: npm install

      - name: Scan and push to WeChat
        env:
          PUSHPLUS_TOKEN: ${{ inputs.pushplus_token != '' && inputs.pushplus_token || secrets.PUSHPLUS_TOKEN }}
          CHANNELS_INPUT: ${{ inputs.channels }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          ENABLE_AI_SUMMARY: ${{ inputs.enable_ai_summary }}
        run: |
          if [ -z "$PUSHPLUS_TOKEN" ]; then
            echo "::error::缺少 PushPlus token：请在 workflow_dispatch 填 pushplus_token 或在仓库 Secrets 配置 PUSHPLUS_TOKEN"
            exit 1
          fi

          # 启动本地 server
          PORT=3000 node server.js &
          SERVER_PID=$!
          sleep 3
          curl -sf --max-time 5 http://localhost:3000 || { echo "::error::server 未启动"; kill $SERVER_PID 2>/dev/null; exit 1; }

          # 默认全量 56 个频道清单
          ALL_56_CHANNELS='["信報財經新聞","Finance730","香港經濟日報 HKET","香港財經時報 HKBT","新城財經台","香港金融管理局","游庭皓的財經皓角","柴鼠兄弟 ZRBros","风傳媒-下班经济學","老王愛說笑","SHIN LI","自由女神邱沁宜","Better Leaf 好葉","慢活夫妻 George & Dewi","大俠武林","股乾爹 KuKanTieh","Gooaye股癌","理財不能等","懶錢包LazyWallet","M觀點","蕾咪Rami","財經 M 平方 MacroMicro","元大投顧財金頻道","股海老牛","财经风云","视野环球财经","阳光财经","ChineseFN 中文投資網","财经全世界","老李玩钱","土妹发财","贝拉说美股","美投说美股","艾爾文","寶可孟の省錢大作戰","吳淡如人生實用商學院","郭哲榮分析師","央视财经","Bloomberg中国","老徐价值投资","小Lin说","CK财经频道","钱姐说钱","硅谷居士","Mr.Market市场先生","财报狗","天下杂志","商业周刊","今周刊","非凡财经新闻","东森财经新闻","第一财经","FT中文网","观视频工作室","睡前消息","曲博科技教室"]'

          # 解析频道：支持 | 、, 、换行 分隔；留空或填 ALL 时默认全量 56 个频道
          if [ -z "$CHANNELS_INPUT" ] || [ "$CHANNELS_INPUT" = "ALL" ]; then
            CHANNELS_JSON="$ALL_56_CHANNELS"
          else
            CHANNELS_JSON=$(node -e "
              const raw = process.env.CHANNELS_INPUT || '';
              const arr = raw.split(/[|\n,]+/).map(s=>s.trim()).filter(Boolean);
              console.log(JSON.stringify(arr));
            ")
          fi
          echo "Channels: $CHANNELS_JSON"

          # 调用本地 /api/scan
          SCAN_RESP=$(curl -s --max-time 900 -X POST http://localhost:3000/api/scan \
            -H 'Content-Type: application/json' \
            -d "{\"channels\": $CHANNELS_JSON}")
          echo "$SCAN_RESP" | node -e "
            let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
              try{const j=JSON.parse(d);if(!j.items) throw Error('no items'); console.log('扫描到', j.items.length, '条');}
              catch(e){console.error('扫描结果解析失败',e.message, d.slice(0,500)); process.exit(1)}
            })"
          echo "$SCAN_RESP" > scan_result.json

          # 生成 Style A「电子杂志 × 电子墨水」HTML 并分条推送到 PushPlus
          node << 'NODE'
          import fs from 'node:fs';
          const scan = JSON.parse(fs.readFileSync('scan_result.json','utf8'));
          const items = scan.items || [];

          const esc = s => String(s||'').replace(/[&<>"']/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
          const sections = items.map((x,i)=> x.error
            ? `<section style="margin:10px 0;padding:10px 12px;border:1.5px solid #000000;border-left:4px solid #000000;background:#ffffff;box-shadow:2px 2px 0 #000000;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                  <span style="background:#000000;color:#00ff66;padding:1px 5px;font-size:9.5px;font-weight:700;font-family:monospace,sans-serif;">SCAN ERROR</span>
                  <span style="font-family:monospace,sans-serif;font-size:10.5px;font-weight:700;color:#111111;">[${i+1}] ${esc(x.channel)} · 未完成读取</span>
                </div>
                <p style="margin:4px 0 0;color:#444444;font-size:11.5px;line-height:1.6;">${esc(x.error)}</p>
              </section>`
            : `<section style="margin:10px 0;padding:12px;border:1.5px solid #111111;background:#ffffff;box-shadow:2px 2px 0 #000000;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:6px;border-bottom:1px solid #f0f0f0;padding-bottom:5px;">
                  <div style="font-family:monospace,sans-serif;font-size:10.5px;color:#111111;font-weight:700;flex:1;word-break:break-all;">
                    <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;margin-right:4px;">#${i+1}</span>
                    ${esc(x.channel)} <span style="color:#666666;font-weight:normal;">· ${esc(x.published)}</span>
                  </div>
                  <div style="font-family:monospace,sans-serif;font-size:9.5px;color:#555555;flex-shrink:0;">${esc(x.status||'')}</div>
                </div>
                <h3 style="margin:6px 0 8px;font-size:13px;line-height:1.45;font-weight:700;font-family:'Noto Serif SC',Georgia,serif,sans-serif;">
                  <a href="${esc(x.url)}" style="color:#111111;text-decoration:underline;text-underline-offset:3px;word-break:break-all;">${esc(x.title)}</a>
                </h3>
                ${x.transcript ? `
                  <div style="margin-top:8px;padding:8px 10px;background:#f5f6f8;border:1px solid #e2e4e8;border-left:3.5px solid #000000;color:#111111;white-space:pre-wrap;word-break:break-word;font-size:11.5px;line-height:1.7;">${esc(x.transcript)}</div>
                ` : `
                  <div style="margin-top:8px;padding:6px 8px;background:#f5f6f8;border:1px dashed #cccccc;color:#777777;font-size:11px;font-style:italic;">该视频未提供公开中文字幕，请点击标题查看原视频。</div>
                `}
              </section>`
          ).join('');

          // AI 总结（可选）：DeepSeek 主题聚类；失败自动降级，content 仍可推送
          let summaryHtml = '';
          if (String(process.env.ENABLE_AI_SUMMARY) === 'true' && process.env.DEEPSEEK_API_KEY) {
            try {
              const r = await fetch('http://localhost:3000/api/summarize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items })
              });
              const d = await r.json();
              if (r.ok && d && d.ok && d.summaryHtml) {
                summaryHtml = d.summaryHtml;
                console.log('✅ 已附加 AI 主题聚类总结');
              } else {
                console.log('⚠️ AI 总结未启用/失败，降级推送：', d && (d.reason || d.error) || ('HTTP ' + r.status));
              }
            } catch (e) {
              console.log('⚠️ AI 总结异常，降级推送：', e.message);
            }
          } else {
            console.log('ℹ️ 未启用 AI 总结（ENABLE_AI_SUMMARY 或 DEEPSEEK_API_KEY 缺失）');
          }

          const baseContent = `<div style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Serif SC',Georgia,sans-serif;background-color:#eeeff2;color:#111111;padding:16px 12px;font-size:12px;line-height:1.65;max-width:680px;margin:0 auto;box-sizing:border-box;">
            
            <!-- 杂志页眉 / Top Issue Bar -->
            <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;border-bottom:1.5px solid #111111;font-family:monospace,sans-serif;font-size:10px;color:#111111;margin-bottom:12px;letter-spacing:0.5px;">
              <div style="display:flex;align-items:center;gap:6px;">
                <span style="display:inline-block;width:7px;height:7px;background:#00ff66;border:1.5px solid #000000;"></span>
                <span style="font-weight:700;">OCTOPUS AI // 全景分析</span>
              </div>
              <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;font-size:9px;">STYLE A · 电子杂志 × 电子墨水</span>
            </div>

            <!-- 封面看板 / Title Section -->
            <div style="background:#0a0a0b;border:2px solid #000000;padding:14px 14px;margin-bottom:12px;box-shadow:3px 3px 0 #000000;">
              <div style="font-family:monospace,sans-serif;font-size:9.5px;color:#00ff66;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;font-weight:700;">
                ◈ MULTI-MODEL INTELLIGENCE REPORT
              </div>
              <h1 style="margin:0;font-size:19px;font-weight:900;color:#00ff66;letter-spacing:0.5px;line-height:1.25;font-family:'Noto Serif SC',Georgia,serif,sans-serif;">
                章鱼 AI 全景分析
              </h1>
              <div style="margin-top:6px;font-size:11.5px;color:#ffffff;line-height:1.55;font-weight:500;">
                全网 AI 调研境内境外数据，由多个大模型混合部署 。
              </div>
              <div style="margin-top:10px;padding-top:8px;border-top:1px dashed #333333;display:flex;flex-wrap:gap:6px;align-items:center;font-family:monospace,sans-serif;font-size:10px;color:#aaaaaa;">
                <span style="background:#000000;color:#00ff66;padding:1px 5px;border:1px solid #00ff66;font-weight:700;">多模型协同</span>
                <span style="color:#ffffff;">Claude · ChatGPT · Gemini · Grok · Qwen · Kimi</span>
              </div>
            </div>

            <!-- 简报状态条 -->
            <div style="background:#ffffff;border:1.5px solid #111111;padding:8px 10px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;font-family:monospace,sans-serif;font-size:10px;color:#111111;box-shadow:2px 2px 0 #000000;">
              <div><span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;margin-right:5px;">情报流</span> <span style="font-weight:700;">共 ${items.length} 条视频情报</span></div>
              <div>规范：台湾/台灣 统一规范为 <span style="background:#000000;color:#00ff66;padding:1px 4px;font-weight:700;">中国台湾</span></div>
            </div>

            <!-- 视频情报流 -->
            ${sections}

            <!-- 尾页宣言 / Editorial Manifesto -->
            <div style="margin-top:16px;border:1.5px solid #111111;background:#ffffff;padding:14px;box-shadow:3px 3px 0 #000000;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-family:monospace,sans-serif;font-size:9.5px;border-bottom:1px solid #eeeeee;padding-bottom:6px;">
                <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;">EDITORIAL MANIFESTO</span>
                <span style="color:#666666;">章鱼 AI · 全景视野</span>
              </div>
              <div style="font-size:12px;font-weight:700;color:#111111;line-height:1.6;margin-bottom:8px;">
                作者：章鱼 ai &nbsp; &nbsp; &nbsp; 仅供参考，分析研究
              </div>
              <div style="font-size:11.5px;color:#222222;line-height:1.75;text-align:justify;border-left:3px solid #000000;padding:8px 10px;background:#f5f6f8;margin-bottom:10px;">
                全网境内外为你寻找蛛丝马迹-提供全景视野分析 由多模型协同推理决策 ，底层所使用的大语言模型（LLM）多模式背后结合使用了多种不同的先进模型，包括但不限于 Claude、ChatGPT、Gemini、Grok、Qwen 以及 Kimi。 根据不同的资产管理任务需求，更好地发挥各个模型的优势来提供数据支持！[加油]
              </div>
              <div style="font-family:monospace,sans-serif;font-size:9px;color:#888888;text-align:center;border-top:1px solid #eeeeee;padding-top:6px;">
                STYLE A「电子杂志 × 电子墨水」· 微信竖版阅读版 · 仅供研究参考
              </div>
            </div>

          </div>`;

          const content = (summaryHtml || '') + baseContent;
          const title = '章鱼 AI 全景分析';
          fs.writeFileSync('brief.html', content);

          const PUSHPLUS_MAX_CHARS = 90000;
          function splitHtmlBySections(html, maxChars = PUSHPLUS_MAX_CHARS) {
            const parts=[]; const secs = html.split(/(?=<section\b)/i).filter(s=>s.trim()); let buf='';
            const flush=()=>{ if(buf.trim()){ parts.push(buf); buf=''; } };
            const splitOversizedSection=(sec,max)=>{
              const out=[]; const headMatch=sec.match(/^<section\b[^>]*>/i); const head=headMatch?headMatch[0]:'<section>'; const tailMatch=sec.match(/<\/section>\s*$/i); const tail=tailMatch?tailMatch[0]:'</section>'; const headEnd=headMatch?headMatch[0].length:9; const inner=sec.slice(headEnd, sec.length-tail.length); const pieceBudget=max-Buffer.byteLength(head+tail,'utf8');
              if(pieceBudget<=0){ let s=sec; while(Buffer.byteLength(s,'utf8')>max){ let lo=0,hi=s.length; while(lo<hi){const mid=(lo+hi+1)>>1; if(Buffer.byteLength(s.slice(0,mid),'utf8')<=max) lo=mid; else hi=mid-1;} out.push(s.slice(0,lo)); s=s.slice(lo);} if(s) out.push(s); return out; }
              const chunks=inner.split(/(?=<\/p>|<p\b|<br\s*\/?>|。)/i); let cur='';
              for(const c of chunks){ if(Buffer.byteLength(c,'utf8')>pieceBudget){ if(cur){ out.push(head+cur+tail); cur=''; } let s=c; while(Buffer.byteLength(s,'utf8')>pieceBudget){ let lo=0,hi=s.length; while(lo<hi){const mid=(lo+hi+1)>>1; if(Buffer.byteLength(s.slice(0,mid),'utf8')<=pieceBudget) lo=mid; else hi=mid-1;} let cut=lo; const win=s.slice(Math.max(0,lo-200),lo); const m=win.match(/[。！？\n]/g); if(m) cut=lo-200+win.lastIndexOf(m[m.length-1])+1; out.push(head+s.slice(0,cut)+tail); s=s.slice(cut);} if(s) cur=s; } else if(Buffer.byteLength(cur+c,'utf8')>pieceBudget && cur){ out.push(head+cur+tail); cur=c; } else { cur+=c; } } if(cur) out.push(head+cur+tail); return out;
            };
            for(const sec of secs){ if(Buffer.byteLength(sec,'utf8')>maxChars){ flush(); for(const p of splitOversizedSection(sec,maxChars)) parts.push(p); continue; } if(Buffer.byteLength(buf+sec,'utf8')>maxChars) flush(); buf+=sec; } flush(); return parts;
          }

          let header='', footer='', bodyOnly=content;
          const firstIdx=content.search(/<section\b/i); const lastEnd=content.toLowerCase().lastIndexOf('</section>');
          if(firstIdx!==-1 && lastEnd!==-1 && lastEnd>firstIdx){ header=content.slice(0,firstIdx); footer=content.slice(lastEnd+'</section>'.length); bodyOnly=content.slice(firstIdx,lastEnd+'</section>'.length); }
          else if(firstIdx!==-1){ header=content.slice(0,firstIdx); bodyOnly=content.slice(firstIdx); footer=''; }
          const overhead=Buffer.byteLength(header+footer,'utf8');
          let chunks= overhead>90000 ? splitHtmlBySections(content,90000) : splitHtmlBySections(bodyOnly, 90000-overhead);
          if(!chunks.length){ const fb=(header+bodyOnly+footer)||content; chunks=splitHtmlBySections(fb,90000); if(!chunks.length) chunks=[fb]; if(header||footer){header=''; footer='';} }
          console.log(`内容 ${Buffer.byteLength(content,'utf8')} 字节，分 ${chunks.length} 条发送`);
          fs.writeFileSync('chunks.json', JSON.stringify({header, footer, chunks, title}, null, 2));

          const token = process.env.PUSHPLUS_TOKEN;
          let okCount=0;
          for(let i=0;i<chunks.length;i++){
            const partTitle = chunks.length>1 ? `${title} (${i+1}/${chunks.length})` : title;
            const partContent = (header||footer) ? `${header}${chunks[i]}${footer}` : chunks[i];
            const payload = JSON.stringify({ token, title: partTitle, content: partContent, template: 'html', channel: 'wechat' });
            console.log(`推送 ${i+1}/${chunks.length}: ${partTitle} (${Buffer.byteLength(partContent,'utf8')} bytes)`);
            let r, text, data;
            try {
              r = await fetch('https://www.pushplus.plus/send', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: payload });
              text = await r.text();
              try{ data=JSON.parse(text);}catch{ data={raw:text} }
            } catch(e){
              console.error(`第 ${i+1} 条网络异常:`, e.message);
              process.exit(1);
            }
            console.log(`  -> HTTP ${r.status}`, JSON.stringify(data).slice(0,500));
            if(data.code!==200){ console.error(`第 ${i+1} 条失败:`, data.msg||data.raw||JSON.stringify(data)); process.exit(1); }
            okCount++;
            if(i < chunks.length-1) await new Promise(r=>setTimeout(r,800));
          }
          console.log(`推送完成 ${okCount}/${chunks.length}`);
          NODE

          kill $SERVER_PID 2>/dev/null || true

      - name: Upload scan artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: daily-scan-result
          path: |
            scan_result.json
            brief.html
            chunks.json

  # ─── 每日定时扫描 + 自动推送 ───
  daily-scan-and-push:
    if: ${{ github.event_name == 'schedule' }}
    needs: build-and-test
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Cache node_modules
        uses: actions/cache@v4
        with:
          path: node_modules
          key: ${{ runner.os }}-node${{ env.NODE_VERSION }}-${{ hashFiles('package-lock.json', 'package.json') }}
          restore-keys: |
            ${{ runner.os }}-node${{ env.NODE_VERSION }}-

      - name: Install dependencies
        run: npm install

      - name: Daily scan and push
        env:
          PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
        run: |
          if [ -z "$PUSHPLUS_TOKEN" ]; then
            echo "::warning::未配置 PUSHPLUS_TOKEN，仅执行扫描，不推送微信"
          fi

          PORT=3000 node server.js &
          SERVER_PID=$!
          sleep 3
          curl -sf --max-time 5 http://localhost:3000 || { echo "::error::server 未启动"; kill $SERVER_PID 2>/dev/null; exit 1; }

          # 默认全量推送：与 app.js 同步的 56 个频道
          CHANNELS_JSON='["信報財經新聞","Finance730","香港經濟日報 HKET","香港財經時報 HKBT","新城財經台","香港金融管理局","游庭皓的財經皓角","柴鼠兄弟 ZRBros","风傳媒-下班经济學","老王愛說笑","SHIN LI","自由女神邱沁宜","Better Leaf 好葉","慢活夫妻 George & Dewi","大俠武林","股乾爹 KuKanTieh","Gooaye股癌","理財不能等","懶錢包LazyWallet","M觀點","蕾咪Rami","財經 M 平方 MacroMicro","元大投顧財金頻道","股海老牛","财经风云","视野环球财经","阳光财经","ChineseFN 中文投資網","财经全世界","老李玩钱","土妹发财","贝拉说美股","美投说美股","艾爾文","寶可孟の省錢大作戰","吳淡如人生實用商學院","郭哲榮分析師","央视财经","Bloomberg中国","老徐价值投资","小Lin说","CK财经频道","钱姐说钱","硅谷居士","Mr.Market市场先生","财报狗","天下杂志","商业周刊","今周刊","非凡财经新闻","东森财经新闻","第一财经","FT中文网","观视频工作室","睡前消息","曲博科技教室"]'
          echo "Channels: $CHANNELS_JSON"

          SCAN_RESP=$(curl -s --max-time 900 -X POST http://localhost:3000/api/scan \
            -H 'Content-Type: application/json' \
            -d "{\"channels\": $CHANNELS_JSON}")
          echo "$SCAN_RESP" | node -e "
            let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{
              try{const j=JSON.parse(d);if(!j.items) throw Error('no items'); console.log('扫描到', j.items.length, '条');}
              catch(e){console.error('扫描结果解析失败',e.message, d.slice(0,500)); process.exit(1)}
            })"
          echo "$SCAN_RESP" > scan_result.json

          # 如果有 token 则推送
          if [ -n "$PUSHPLUS_TOKEN" ]; then
            node << 'NODE'
            import fs from 'node:fs';
            const scan = JSON.parse(fs.readFileSync('scan_result.json','utf8'));
            const items = scan.items || [];
            const esc = s => String(s||'').replace(/[&<>"']/g,c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
            const sections = items.map((x,i)=> x.error
              ? `<section style="margin:10px 0;padding:10px 12px;border:1.5px solid #000000;border-left:4px solid #000000;background:#ffffff;box-shadow:2px 2px 0 #000000;">
                  <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                    <span style="background:#000000;color:#00ff66;padding:1px 5px;font-size:9.5px;font-weight:700;font-family:monospace,sans-serif;">SCAN ERROR</span>
                    <span style="font-family:monospace,sans-serif;font-size:10.5px;font-weight:700;color:#111111;">[${i+1}] ${esc(x.channel)} · 未完成读取</span>
                  </div>
                  <p style="margin:4px 0 0;color:#444444;font-size:11.5px;line-height:1.6;">${esc(x.error)}</p>
                </section>`
              : `<section style="margin:10px 0;padding:12px;border:1.5px solid #111111;background:#ffffff;box-shadow:2px 2px 0 #000000;">
                  <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:6px;border-bottom:1px solid #f0f0f0;padding-bottom:5px;">
                    <div style="font-family:monospace,sans-serif;font-size:10.5px;color:#111111;font-weight:700;flex:1;word-break:break-all;">
                      <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;margin-right:4px;">#${i+1}</span>
                      ${esc(x.channel)} <span style="color:#666666;font-weight:normal;">· ${esc(x.published)}</span>
                    </div>
                    <div style="font-family:monospace,sans-serif;font-size:9.5px;color:#555555;flex-shrink:0;">${esc(x.status||'')}</div>
                  </div>
                  <h3 style="margin:6px 0 8px;font-size:13px;line-height:1.45;font-weight:700;font-family:'Noto Serif SC',Georgia,serif,sans-serif;">
                    <a href="${esc(x.url)}" style="color:#111111;text-decoration:underline;text-underline-offset:3px;word-break:break-all;">${esc(x.title)}</a>
                  </h3>
                  ${x.transcript ? `
                    <div style="margin-top:8px;padding:8px 10px;background:#f5f6f8;border:1px solid #e2e4e8;border-left:3.5px solid #000000;color:#111111;white-space:pre-wrap;word-break:break-word;font-size:11.5px;line-height:1.7;">${esc(x.transcript)}</div>
                  ` : `
                    <div style="margin-top:8px;padding:6px 8px;background:#f5f6f8;border:1px dashed #cccccc;color:#777777;font-size:11px;font-style:italic;">该视频未提供公开中文字幕，请点击标题查看原视频。</div>
                  `}
                </section>`
            ).join('');

            // AI 总结（可选）：仅当配置了 DEEPSEEK_API_KEY 才启用
            let summaryHtml = '';
            if (process.env.DEEPSEEK_API_KEY) {
              try {
                const r = await fetch('http://localhost:3000/api/summarize', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items })
                });
                const d = await r.json();
                if (r.ok && d && d.ok && d.summaryHtml) {
                  summaryHtml = d.summaryHtml;
                  console.log('✅ 已附加 AI 主题聚类总结');
                } else {
                  console.log('⚠️ AI 总结未启用/失败，降级推送：', d && (d.reason || d.error) || ('HTTP ' + r.status));
                }
              } catch (e) {
                console.log('⚠️ AI 总结异常，降级推送：', e.message);
              }
            } else {
              console.log('ℹ️ 未配置 DEEPSEEK_API_KEY，跳过 AI 总结');
            }

            const baseContent = `<div style="font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Serif SC',Georgia,sans-serif;background-color:#eeeff2;color:#111111;padding:16px 12px;font-size:12px;line-height:1.65;max-width:680px;margin:0 auto;box-sizing:border-box;">
              
              <!-- 杂志页眉 / Top Issue Bar -->
              <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;border-bottom:1.5px solid #111111;font-family:monospace,sans-serif;font-size:10px;color:#111111;margin-bottom:12px;letter-spacing:0.5px;">
                <div style="display:flex;align-items:center;gap:6px;">
                  <span style="display:inline-block;width:7px;height:7px;background:#00ff66;border:1.5px solid #000000;"></span>
                  <span style="font-weight:700;">OCTOPUS AI // 全景分析</span>
                </div>
                <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;font-size:9px;">STYLE A · 电子杂志 × 电子墨水</span>
              </div>

              <!-- 封面看板 / Title Section -->
              <div style="background:#0a0a0b;border:2px solid #000000;padding:14px 14px;margin-bottom:12px;box-shadow:3px 3px 0 #000000;">
                <div style="font-family:monospace,sans-serif;font-size:9.5px;color:#00ff66;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;font-weight:700;">
                  ◈ MULTI-MODEL INTELLIGENCE REPORT
                </div>
                <h1 style="margin:0;font-size:19px;font-weight:900;color:#00ff66;letter-spacing:0.5px;line-height:1.25;font-family:'Noto Serif SC',Georgia,serif,sans-serif;">
                  章鱼 AI 全景分析
                </h1>
                <div style="margin-top:6px;font-size:11.5px;color:#ffffff;line-height:1.55;font-weight:500;">
                  全网 AI 调研境内境外数据，由多个大模型混合部署 。
                </div>
                <div style="margin-top:10px;padding-top:8px;border-top:1px dashed #333333;display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-family:monospace,sans-serif;font-size:10px;color:#aaaaaa;">
                  <span style="background:#000000;color:#00ff66;padding:1px 5px;border:1px solid #00ff66;font-weight:700;">多模型协同</span>
                  <span style="color:#ffffff;">Claude · ChatGPT · Gemini · Grok · Qwen · Kimi</span>
                </div>
              </div>

              <!-- 简报状态条 -->
              <div style="background:#ffffff;border:1.5px solid #111111;padding:8px 10px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;font-family:monospace,sans-serif;font-size:10px;color:#111111;box-shadow:2px 2px 0 #000000;">
                <div><span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;margin-right:5px;">情报流</span> <span style="font-weight:700;">共 ${items.length} 条视频情报</span></div>
                <div>规范：台湾/台灣 统一规范为 <span style="background:#000000;color:#00ff66;padding:1px 4px;font-weight:700;">中国台湾</span></div>
              </div>

              <!-- 视频情报流 -->
              ${sections}

              <!-- 尾页宣言 / Editorial Manifesto -->
              <div style="margin-top:16px;border:1.5px solid #111111;background:#ffffff;padding:14px;box-shadow:3px 3px 0 #000000;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-family:monospace,sans-serif;font-size:9.5px;border-bottom:1px solid #eeeeee;padding-bottom:6px;">
                  <span style="background:#000000;color:#00ff66;padding:1px 5px;font-weight:700;">EDITORIAL MANIFESTO</span>
                  <span style="color:#666666;">章鱼 AI · 全景视野</span>
                </div>
                <div style="font-size:12px;font-weight:700;color:#111111;line-height:1.6;margin-bottom:8px;">
                  作者：章鱼 ai &nbsp; &nbsp; &nbsp; 仅供参考，分析研究
                </div>
                <div style="font-size:11.5px;color:#222222;line-height:1.75;text-align:justify;border-left:3px solid #000000;padding:8px 10px;background:#f5f6f8;margin-bottom:10px;">
                  全网境内外为你寻找蛛丝马迹-提供全景视野分析 由多模型协同推理决策 ，底层所使用的大语言模型（LLM）多模式背后结合使用了多种不同的先进模型，包括但不限于 Claude、ChatGPT、Gemini、Grok、Qwen 以及 Kimi。 根据不同的资产管理任务需求，更好地发挥各个模型的优势来提供数据支持！[加油]
                </div>
                <div style="font-family:monospace,sans-serif;font-size:9px;color:#888888;text-align:center;border-top:1px solid #eeeeee;padding-top:6px;">
                  STYLE A「电子杂志 × 电子墨水」· 微信竖版阅读版 · 仅供研究参考
                </div>
              </div>

            </div>`;

            const content = (summaryHtml || '') + baseContent;
            const title = '章鱼 AI 全景分析';
            fs.writeFileSync('brief.html', content);

            const PUSHPLUS_MAX_CHARS = 90000;
            function splitHtmlBySections(html, maxChars = PUSHPLUS_MAX_CHARS) {
              const parts=[]; const secs = html.split(/(?=<section\b)/i).filter(s=>s.trim()); let buf='';
              const flush=()=>{ if(buf.trim()){ parts.push(buf); buf=''; } };
              const splitOversizedSection=(sec,max)=>{
                const out=[]; const headMatch=sec.match(/^<section\b[^>]*>/i); const head=headMatch?headMatch[0]:'<section>'; const tailMatch=sec.match(/<\/section>\s*$/i); const tail=tailMatch?tailMatch[0]:'</section>'; const headEnd=headMatch?headMatch[0].length:9; const inner=sec.slice(headEnd, sec.length-tail.length); const pieceBudget=max-Buffer.byteLength(head+tail,'utf8');
                if(pieceBudget<=0){ let s=sec; while(Buffer.byteLength(s,'utf8')>max){ let lo=0,hi=s.length; while(lo<hi){const mid=(lo+hi+1)>>1; if(Buffer.byteLength(s.slice(0,mid),'utf8')<=max) lo=mid; else hi=mid-1;} out.push(s.slice(0,lo)); s=s.slice(lo);} if(s) out.push(s); return out; }
                const chunks=inner.split(/(?=<\/p>|<p\b|<br\s*\/?>|。)/i); let cur='';
                for(const c of chunks){ if(Buffer.byteLength(c,'utf8')>pieceBudget){ if(cur){ out.push(head+cur+tail); cur=''; } let s=c; while(Buffer.byteLength(s,'utf8')>pieceBudget){ let lo=0,hi=s.length; while(lo<hi){const mid=(lo+hi+1)>>1; if(Buffer.byteLength(s.slice(0,mid),'utf8')<=pieceBudget) lo=mid; else hi=mid-1;} let cut=lo; const win=s.slice(Math.max(0,lo-200),lo); const m=win.match(/[。！？\n]/g); if(m) cut=lo-200+win.lastIndexOf(m[m.length-1])+1; out.push(head+s.slice(0,cut)+tail); s=s.slice(cut);} if(s) cur=s; } else if(Buffer.byteLength(cur+c,'utf8')>pieceBudget && cur){ out.push(head+cur+tail); cur=c; } else { cur+=c; } } if(cur) out.push(head+cur+tail); return out;
              };
              for(const sec of secs){ if(Buffer.byteLength(sec,'utf8')>maxChars){ flush(); for(const p of splitOversizedSection(sec,maxChars)) parts.push(p); continue; } if(Buffer.byteLength(buf+sec,'utf8')>maxChars) flush(); buf+=sec; } flush(); return parts;
            }

            let header='', footer='', bodyOnly=content;
            const firstIdx=content.search(/<section\b/i); const lastEnd=content.toLowerCase().lastIndexOf('</section>');
            if(firstIdx!==-1 && lastEnd!==-1 && lastEnd>firstIdx){ header=content.slice(0,firstIdx); footer=content.slice(lastEnd+'</section>'.length); bodyOnly=content.slice(firstIdx,lastEnd+'</section>'.length); }
            else if(firstIdx!==-1){ header=content.slice(0,firstIdx); bodyOnly=content.slice(firstIdx); footer=''; }
            const overhead=Buffer.byteLength(header+footer,'utf8');
            let chunks= overhead>90000 ? splitHtmlBySections(content,90000) : splitHtmlBySections(bodyOnly, 90000-overhead);
            if(!chunks.length){ const fb=(header+bodyOnly+footer)||content; chunks=splitHtmlBySections(fb,90000); if(!chunks.length) chunks=[fb]; if(header||footer){header=''; footer='';} }
            console.log(`内容 ${Buffer.byteLength(content,'utf8')} 字节，分 ${chunks.length} 条发送`);
            fs.writeFileSync('chunks.json', JSON.stringify({header, footer, chunks, title}, null, 2));

            const token = process.env.PUSHPLUS_TOKEN;
            let okCount=0;
            for(let i=0;i<chunks.length;i++){
              const partTitle = chunks.length>1 ? `${title} (${i+1}/${chunks.length})` : title;
              const partContent = (header||footer) ? `${header}${chunks[i]}${footer}` : chunks[i];
              const payload = JSON.stringify({ token, title: partTitle, content: partContent, template: 'html', channel: 'wechat' });
              console.log(`推送 ${i+1}/${chunks.length}: ${partTitle} (${Buffer.byteLength(partContent,'utf8')} bytes)`);
              let r, text, data;
              try {
                r = await fetch('https://www.pushplus.plus/send', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: payload });
                text = await r.text();
                try{ data=JSON.parse(text);}catch{ data={raw:text} }
              } catch(e){
                console.error(`第 ${i+1} 条网络异常:`, e.message);
                process.exit(1);
              }
              console.log(`  -> HTTP ${r.status}`, JSON.stringify(data).slice(0,500));
              if(data.code!==200){ console.error(`第 ${i+1} 条失败:`, data.msg||data.raw||JSON.stringify(data)); process.exit(1); }
              okCount++;
              if(i < chunks.length-1) await new Promise(r=>setTimeout(r,800));
            }
            console.log(`推送完成 ${okCount}/${chunks.length}`);
            NODE
          fi

          kill $SERVER_PID 2>/dev/null || true

      - name: Upload scan artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: daily-scan-result
          path: |
            scan_result.json
            brief.html
            chunks.json
